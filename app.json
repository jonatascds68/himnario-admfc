{
  "expo": {
    "name": "Himnario ADMFC",
    "slug": "himnario-admfc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "himnarioadmfc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "org.admfc.himnario"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1B3D"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "package": "org.admfc.himnario"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B1B3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}