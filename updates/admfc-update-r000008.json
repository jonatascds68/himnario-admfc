            "tipo": "coro",
            "numero": null,
            "rotulo": "CORO",
            "texto": "Coro.\n//Ha che aguerohoryva 3x \nÑandejara tuichaha. //"
          },
          {
            "tipo": "estrofa",
            "numero": 2,
            "texto": "Este es el Cristo\nQue yo predico\nY no me canso de predicar\nSana a los enfermos\nReprende a los demonios\nY calma la lluvia y la tempestad\n"
          },
          {
            "tipo": "coro",
            "numero": null,
            "rotulo": "CORO",
            "texto": "Y yo le alabaré\nY yo le alabaré\nY yo le alabaré\nDiciendo Gloria a Dios\n\nY yo le alabaré\nY yo le alabaré\nY yo le alabaré\nDiciendo Gloria a Dios"
          }
